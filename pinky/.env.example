# 로컬 개발용. 로봇 업로드는 pinky.env.example → pinky.env 를 사용하세요.
# (.env 숨김 파일은 일부 전송 도구에서 업로드 불가)

PINKY_HOST=0.0.0.0
PINKY_PORT=4200
# mock | ros2
PINKY_BACKEND=ros2
PINKY_DEVICE_CODE=cart-1
CONTROLLER_URL=http://127.0.0.1:4100

# auto: ros2일 때 센서 publisher 자동 기동 / 0: 끔 / 1: 강제
PINKY_SENSOR_PUBLISHER=auto
# 하드웨어 실패 시 토픽에 임시값 발행 (실기에서는 0 권장)
PINKY_SENSOR_FALLBACK=0

PINKY_ADC_I2C=/dev/i2c-1
PINKY_ADC_ADDR=0x08
PINKY_IMU_I2C=/dev/i2c-0
PINKY_IMU_ADDR=0x28
PINKY_BATT_HZ=0.5
PINKY_IMU_HZ=20
PINKY_US_HZ=10

# Lidar (RPLidar C1 — pinky_pro sllidar /dev/ttyAMA0)
PINKY_LIDAR_PORT=/dev/ttyAMA0
PINKY_LIDAR_BAUD=460800
PINKY_LIDAR_HZ=5
# LaserScan 균일 빈 (기본 2160 ≈ 0.167°)
PINKY_LIDAR_BINS=2160
# 1회전 원시 샘플 상한 (큐 누적)
PINKY_LIDAR_RAW_MAX=4320
# HTTP 맵용 포인트 상한
PINKY_LIDAR_API_POINTS=2880
# auto: rplidarc1/serial 실패 시 sllidar_ros2 launch 시도
PINKY_LIDAR_SLLIDAR=auto
