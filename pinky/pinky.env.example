# 로봇에 업로드할 때는 이 파일을 pinky.env 로 복사해 전송하세요.

PINKY_HOST=0.0.0.0
PINKY_PORT=4200
PINKY_BACKEND=ros2
PINKY_DEVICE_CODE=cart-1
# cart-2 로봇에서는 반드시 cart-2 로 바꾸세요 (아니면 S1으로 기동됨).
# 또는 pinky.env.cart-2.example 을 pinky.env 로 복사.
CONTROLLER_URL=http://127.0.0.1:4100

PINKY_SENSOR_PUBLISHER=auto
PINKY_SENSOR_FALLBACK=0

# pinky_pro bringup + navigation 서브프로세스
PINKY_AUTO_LAUNCH=auto
PINKY_DEFER_LIDAR=auto
PINKY_DEFER_BATTERY=auto
PINKY_PRO_LAUNCH_WAIT=8.0
# /scan 무데이터 시 LidarReader 폴백
PINKY_LIDAR_RECOVERY=1
PINKY_LIDAR_RECOVERY_WAIT=12

PINKY_ADC_I2C=/dev/i2c-1
PINKY_ADC_ADDR=0x08
PINKY_IMU_I2C=/dev/i2c-0
PINKY_IMU_ADDR=0x28
PINKY_BATT_HZ=0.5
PINKY_IMU_HZ=20
PINKY_US_HZ=10

PINKY_LIDAR_PORT=/dev/ttyAMA0
PINKY_LIDAR_BAUD=460800
PINKY_LIDAR_HZ=5
PINKY_LIDAR_BINS=2160
PINKY_LIDAR_RAW_MAX=4320
PINKY_LIDAR_API_POINTS=2880
PINKY_LIDAR_SLLIDAR=0
PINKY_MAP=map_test1
PINKY_NAV=1
# 기동 시 AMCL 초기 pose
# cart-1 → S1, cart-2 → S2 (PINKY_DEVICE_CODE). cart-2 는 좌표를 명시하는 것을 권장:
# PINKY_INITIAL_POSE=0.038474577957370054,-0.1911947634013857,0.0
PINKY_INITIAL_POSE_DELAY_SEC=3.0
PINKY_INITIAL_POSE_RETRIES=6
PINKY_INITIAL_POSE_RETRY_GAP_SEC=2.0
PINKY_INITIAL_POSE_PUBLISHES=5
PINKY_HOME_POSE_NEAR_M=0.35
# initialpose 후 모니터 좌표가 옛 TF로 덮이지 않게 유지(초)
PINKY_POSE_HOLD_SEC=12.0
# 대기 중 AMCL lifecycle deactivate (pose 점프 방지). 주행 직전에만 activate.
PINKY_AMCL_IDLE_FREEZE=1
PINKY_AMCL_NODE=amcl
PINKY_LOCALIZE_SETTLE_SEC=1.0
# GET /nav/plan 최대 포인트 (0=제한 없음)
PINKY_PLAN_MAX_POINTS=500
# 주행/initialpose 직후 AMCL deactivate 유예(초).
# 투어 연속 waypoint(dwell~수초)보다 길게 두어 중간 freeze 방지. 다음 goal ensure 가 오면 취소.
PINKY_AMCL_IDLE_FREEZE_DELAY_SEC=45.0
