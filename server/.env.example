WEB_PORT=3000
WEB_SERVER_PORT=4000
WEB_SERVER_HOST=0.0.0.0
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=4100

NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_PORT=4000

WEB_SERVER_URL=http://127.0.0.1:4000
CONTROLLER_URL=http://127.0.0.1:4100

DATABASE_PATH=./data/smartshop.db
JWT_SECRET=smartshop-dev-secret-change-me
# mock: pinky/omx 없이 시뮬. 실제 로봇+OMX 연동 시 주석 처리 또는 real
ADAPTER_MODE=mock
# 단일 로봇 (하위 호환)
PINKY_URL=http://192.168.129.33:4200
# 2대: PINKY_URL_2 또는 PINKY_ROBOTS 사용
# PINKY_URL_2=http://192.168.129.34:4200
# PINKY_ROBOTS=cart-1=http://192.168.129.33:4200,cart-2=http://192.168.129.34:4200
# OMX 로봇팔 — **별도 PC**에서 omx_yolo.server 실행 (관제 PC와 IP 다름)
# OMX PC에서 `hostname -I` 또는 서버 기동 로그의 LAN URL 확인 후 설정
# ADAPTER_MODE=mock 를 끄고 아래 URL 설정
# OMX_URL=http://192.168.129.50:8080
# OMX_CONNECT_TIMEOUT_SEC=5
# OMX_POLL_SEC=0.5
# OMX_PICK_TIMEOUT_SEC=90
# 피킹 순회: 매대/계산대/운송대기 dwell(초), Nav 타임아웃(초)
# PICK_DWELL_SEC=3
# PICK_NAV_TIMEOUT_SEC=180
# 다중 로봇 교통 제어 (PINKY_ROBOTS 2대 등록 시 자동 활성, TRAFFIC_ENABLED=1)
# TRAFFIC_ENABLED=1
# TRAFFIC_CLEARANCE_M=0.20
# TRAFFIC_HOLD_MARGIN_M=0.35
# TRAFFIC_RELEASE_MARGIN_M=0.20
# TRAFFIC_POLL_HZ=2.0
# TRAFFIC_HOME_PRIORITY=fifo
# TRAFFIC_MISSION_TIMEOUT=300
# TRAFFIC_ZONE_RADIUS_M=0.45
# TRAFFIC_STAGING_WAYPOINT=W7
# 선반 아루코 후진은 접근 전진분만 (W1–W6, C는 후진 없음)
# PICK_SHELF_UNDOCK_AFTER_ARUCO=1
# PICK_SHELF_UNDOCK_MAX_M=0.80
# PICK_SHELF_UNDOCK_STEP_M=0.20
# PICK_SHELF_UNDOCK_SPEED_MPS=0.02
UPLOAD_DIR=./uploads
